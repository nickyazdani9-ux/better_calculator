{
  "name": "calculator-2",
  "productName": "Calculator 2.0",
  "version": "0.2.0",
  "description": "Cross-platform extensible symbolic mathematics calculator",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "engines": {"node": ">=22"},
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "catalog": "python3 scripts/export_catalog.py",
    "vendor": "python3 scripts/vendor_pyodide.py",
    "build:web": "node scripts/build-web.mjs",
    "build:native": "node scripts/build-web.mjs --require-vendor",
    "android:init": "npx cap add android",
    "ios:init": "npx cap add ios",
    "sync": "npx cap sync",
    "desktop:run": "electron .",
    "desktop:package": "electron-builder --publish never",
    "test:js": "node --test tests/*.mjs",
    "test:python": "python3 -m pytest tests/test_*.py -q",
    "test": "npm run test:js && npm run test:python"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "@capacitor/android": "8.0.0",
    "@capacitor/ios": "8.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.56.1"
  },
  "build": {
    "appId": "dev.calculator2.app",
    "productName": "Calculator 2.0",
    "directories": {"output": "release/desktop"},
    "files": ["dist/**", "desktop/**", "icons/**", "package.json"],
    "asar": true,
    "npmRebuild": false,
    "mac": {"target": ["zip"], "category": "public.app-category.education", "identity": null},
    "win": {"target": ["portable"]},
    "linux": {"target": ["tar.gz"], "category": "Education", "icon": "icons/512.png"}
  }
}
